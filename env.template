# Django 配置
DEBUG=${DEBUG}
SECRET_KEY=${SECRET_KEY}
ALLOWED_HOSTS=${ALLOWED_HOSTS}

# 上传目录
UPLOAD_ROOT=${UPLOAD_ROOT}

# 数据库配置 (格式: postgres://user:password@host:port/dbname 或 postgresql://...)
DATABASE_URL=${DATABASE_URL}

# Prometheus 配置
PROMETHEUS_URL=${PROMETHEUS_URL}
PUSHGATEWAY_URL=${PUSHGATEWAY_URL}
PROMETHEUS_RULES_DIR=${PROMETHEUS_RULES_DIR}

# Supervisor 配置
SUPERVISOR_XMLRPC_URL=${SUPERVISOR_XMLRPC_URL}
SUPERVISOR_COLLECTOR_COMMAND=${SUPERVISOR_COLLECTOR_COMMAND}
SUPERVISOR_COLLECTOR_ADVERTISE=${SUPERVISOR_COLLECTOR_ADVERTISE}
SUPERVISOR_COLLECTOR_DIR=${SUPERVISOR_COLLECTOR_DIR}

# 萤石云配置（可选，如不需要可以留空）
YS_APPKEY=${YS_APPKEY}
YS_APPSECRET=${YS_APPSECRET}

# IVM 华为云配置（可选，如不需要可以留空）
IVM_BASE_URL=${IVM_BASE_URL}
IVM_USER_ID=${IVM_USER_ID}
IVM_ACCESS_KEY=${IVM_ACCESS_KEY}
IVM_SECRET_KEY=${IVM_SECRET_KEY}

# 阿里云 OSS 配置（可选，如不需要可以留空）
OSS_ENDPOINT=${OSS_ENDPOINT}
OSS_BUCKET_NAME=${OSS_BUCKET_NAME}
OSS_ACCESS_KEY_ID=${OSS_ACCESS_KEY_ID}
OSS_ACCESS_KEY_SECRET=${OSS_ACCESS_KEY_SECRET}

